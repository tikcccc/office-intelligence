# Copy to .env and fill in. .env is git-ignored.
MIMO_API_KEY=
OFFICE_AGENT_MODEL=mimo-v2.6-pro-ultraspeed
# Token Plan keys (tp-...) use a different host:
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Optional: per-task models as provider:model (mimo or deepseek)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# OFFICE_AGENT_CHAT_LLM=mimo:mimo-v2.6-pro-ultraspeed
# OFFICE_AGENT_BRIEF_LLM=mimo:mimo-v2.6-pro-ultraspeed
# OFFICE_AGENT_EXTRACT_LLM=mimo:mimo-v2.6-pro-ultraspeed
# OFFICE_AGENT_EXTRACT_FALLBACK_LLM=deepseek:deepseek-flash

# Optional: Jev judgement model for news filtering and extraction review
# JEV_API_KEY=apikey_your-jev-key
# OFFICE_AGENT_USE_JEV=1

# Privacy: questions are omitted from run logs by default; opt in for troubleshooting.
# OFFICE_AGENT_LOG_INPUT=1

# Docker/Coolify only: exact public HTTPS origin, without a trailing slash.
# OFFICE_AGENT_PUBLIC_ORIGIN=https://market.example.com
# Shared limits for public AI jobs; a job may make multiple model calls.
# OFFICE_AGENT_DAILY_JOBS=30
# OFFICE_AGENT_REFRESH_INTERVAL=120
